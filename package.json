{
  "name": "sans-emoji",
  "version": "2026.10.10",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienguillon/sans-emoji.git"
  },
  "type": "module",
  "description": "Dismiss colon-triggered emoji autocomplete on Atlassian sites.",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "biome check .",
    "lint:ext": "node scripts/lint-extension.ts",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "pnpm build && playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && node scripts/build.ts && pnpm lint:ext",
    "build": "pnpm typecheck && node scripts/build.ts",
    "icons": "node scripts/icons.ts",
    "package": "pnpm check && node scripts/package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "5.0.3",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3",
    "web-ext": "10.6.0"
  }
}
