{
  "manifest_version": 3,
  "name": "Sans Emoji",
  "version": "2026.10.15",
  "description": "Dismiss colon-triggered emoji autocomplete on Atlassian sites without changing your text.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sans-emoji@extensions.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*",
        "https://*.atlassian.com/*",
        "https://*.bitbucket.org/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png",
    "512": "icons/icon512.png"
  }
}
